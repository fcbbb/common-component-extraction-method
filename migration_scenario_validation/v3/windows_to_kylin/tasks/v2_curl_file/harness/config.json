  "regression_tests": null,
  "gates": {
    "build": "configure and build curl with the file protocol handler on the target platform",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|CloseHandle|SetFilePointer|GetFileSize|FindFirstFileA|FindFirstFileW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|CreateFile(?!Exception)|ReadFile\\(|WriteFile\\(|CloseHandle|SetFilePointer|GetFileSize|FindFirstFile",
      "exclude_globs": [
