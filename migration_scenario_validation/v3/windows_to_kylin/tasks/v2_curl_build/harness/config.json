{
  "task_id": "v2_curl_build",
  "scenario": "windows_to_kylin",
  "level": "L3",
  "build": {
    "command": "cmake -S . -B {build} -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCURL_USE_OPENSSL=ON -DUSE_NGHTTP2=OFF -DCURL_USE_LIBPSL=OFF && cmake --build {build} -j2",
    "artifact": "{build}/src/curl"
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "bash {root}/harness/tls_probe.sh --port 18444 --path {build}/src/curl"
  },
  "regression_tests": null,
  "gates": {
    "build": "configure and build Foundation on the target platform",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|WaitForSingleObject|WSAStartup|RegOpenKeyEx|RegCreateKeyEx|CoCreateInstance|LoadLibraryA|LoadLibraryW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|CreateFile(?!Exception)|WaitForSingleObject|RegOpenKey|CoCreateInstance",
      "exclude_globs": [
        "**/*_WIN32*",
        "**/*_win32*",
        "**/*w32*",
        "**/*W32*",
        "**/*_windows.c",
        "**/*_windows.h",
        "**/win32/**",
        "**/Win32/**",
        "**/win/**",
        "**/Windows/**",
        "**/windows/**",
        "**/projects/Windows/**",
        "**/winbuild/**"
      ],
      "source_dirs": [
        "CMakeLists.txt",
        "CMake"
      ]
    },
    "target_api": {
      "source_dirs": [
        "CMakeLists.txt",
        "CMake"
      ],
      "source_regex": "(?i)\\b(?:cmake|configure|make)\\b",
      "min_hits": 1
    },
    "behavior": "the agent-authored build produces libcurl and the tool from this tree and a real TLS request succeeds",
    "regression": "the produced tool reports its version and exits cleanly"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.16.5"
  },
  "task_family": "v3",
  "family": "curl_build",
  "family_type": "build_system",
  "sequence": 13,
  "library_manifest": "v3/windows_to_kylin/library/manifest.json",
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ]
}
