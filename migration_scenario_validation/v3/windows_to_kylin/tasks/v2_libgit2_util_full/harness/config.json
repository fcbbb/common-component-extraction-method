{
  "task_id": "v2_libgit2_util_full",
  "scenario": "windows_to_kylin",
  "level": "L3",
  "build": {
    "command": "cmake -S . -B {build} -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTS=ON -DBUILD_CLI=OFF -DUSE_SSH=OFF -DUSE_HTTPS=OFF -DUSE_BUNDLED_ZLIB=ON -DREGEX_BACKEND=builtin && cmake --build {build} -j2",
    "artifact": "{build}/libgit2.a"
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "cd {build} && ./util_tests -v -sfilebuf -sftruncate -sstat -spath::core -sprocess::start && ./libgit2_tests -v -xonline -sthreads::basic"
  },
  "regression_tests": null,
  "gates": {
    "build": "configure and build Foundation on the target platform",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|WaitForSingleObject|WSAStartup|RegOpenKeyEx|RegCreateKeyEx|CoCreateInstance|LoadLibraryA|LoadLibraryW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|CreateFile(?!Exception)|WaitForSingleObject|RegOpenKey|CoCreateInstance",
      "exclude_globs": [
        "**/*_WIN32*",
        "**/*_win32*",
        "**/*w32*",
        "**/*W32*",
        "**/*_windows.c",
        "**/*_windows.h",
        "**/win32/**",
        "**/Win32/**",
        "**/win/**",
        "**/Windows/**",
        "**/windows/**",
        "**/projects/Windows/**",
        "**/winbuild/**"
      ],
      "source_dirs": [
        "src/util/unix"
      ]
    },
    "target_api": {
      "source_dirs": [
        "src/util/unix"
      ],
      "source_regex": "\\b(?:pthread_[A-Za-z0-9_]+|mmap|munmap|realpath|open|read|write|stat|fstat|unlink|mkdir|rename|opendir|readdir|fork|execve|waitpid|pipe|dup2)\\b",
      "min_hits": 1
    },
    "behavior": "libgit2 builds and the selected offline utility and threading suites pass",
    "regression": "the library links and the remaining offline suites stay green"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.16.5"
  },
  "task_family": "v3",
  "family": "libgit2_util",
  "family_type": "localization",
  "sequence": 9,
  "library_manifest": "v3/windows_to_kylin/library/manifest.json",
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ]
}
