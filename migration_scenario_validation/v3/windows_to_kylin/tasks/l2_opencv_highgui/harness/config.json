{
  "task_id": "l2_opencv_highgui",
  "scenario": "windows_to_kylin",
  "level": "L2",
  "build": {
    "command": "cmake -S . -B {build} -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DBUILD_LIST=core,imgproc,imgcodecs,highgui,ts -DWITH_GTK=ON -DWITH_QT=OFF -DBUILD_TESTS=ON -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_opencv_python3=OFF && cmake --build {build} -j2",
    "artifact": "{build}/lib/libopencv_highgui.a"
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "cd {build} && timeout 900 xvfb-run -a ./bin/opencv_test_highgui --gtest_filter=Highgui_GUI.*"
  },
  "gates": {
    "build": "configure and build highgui on the target platform",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|WaitForSingleObject|WSAStartup|RegOpenKeyEx|RegCreateKeyEx|CoCreateInstance|LoadLibraryA|LoadLibraryW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|CreateFile|WaitForSingleObject|RegOpenKey|CoCreateInstance",
      "exclude_globs": [
        "**/*_WIN32*",
        "**/*_win32*",
        "**/*w32*",
        "**/*W32*",
        "**/*_windows.c",
        "**/*_windows.h",
        "**/win32/**",
        "**/Win32/**",
        "**/win/**",
        "**/Windows/**",
        "**/windows/**",
        "**/projects/Windows/**",
        "**/winbuild/**"
      ],
      "source_dirs": [
        "modules/highgui/src/window_gtk.cpp"
      ]
    },
    "target_api": "the rebuilt backend calls the platform windowing API rather than a hand-written window stub",
    "behavior": "the highgui GUI tests pass under a virtual X server",
    "regression": "the core, imgproc and imgcodecs suites stay green"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.16.5"
  },
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ],
  "task_family": "v3",
  "library_manifest": "v3/windows_to_kylin/library/manifest.json",
  "regression_tests": null,
  "family": "opencv_highgui",
  "family_type": "pattern",
  "sequence": 19
}
