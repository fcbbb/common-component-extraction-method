{
  "task_id": "l2_nginx_files",
  "scenario": "windows_to_kylin",
  "level": "L2",
  "build": {
    "command": "./auto/configure --prefix={build}/nginx --without-http_rewrite_module --without-http_gzip_module && make -j",
    "artifact": "{work}/objs/nginx"
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "bash {root}/harness/nginx_smoke.sh --binary {work}/objs/nginx --port 18080 && cd {work}/nginx-tests && TEST_NGINX_BINARY={work}/objs/nginx prove -I lib autoindex.t range.t"
  },
  "gates": {
    "build": "configure and build the task target on Kylin V10",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|WaitForSingleObject|WSAStartup|RegOpenKeyEx|RegCreateKeyEx|CoCreateInstance|LoadLibraryA|LoadLibraryW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|CreateFile|WaitForSingleObject|RegOpenKey|CoCreateInstance",
      "exclude_globs": [
        "**/*_WIN32*",
        "**/*_win32*",
        "**/*w32*",
        "**/*W32*",
        "**/*_windows.c",
        "**/*_windows.h",
        "**/win32/**",
        "**/Win32/**",
        "**/win/**",
        "**/Windows/**",
        "**/windows/**",
        "**/projects/Windows/**",
        "**/winbuild/**"
      ],
      "source_dirs": [
        "src/os/unix/ngx_files.c"
      ]
    },
    "behavior": "static file serving works and autoindex.t and range.t pass"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.16.5"
  },
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ]
}