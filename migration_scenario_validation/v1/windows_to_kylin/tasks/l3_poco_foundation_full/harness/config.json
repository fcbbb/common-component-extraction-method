{
  "task_id": "l3_poco_foundation_full",
  "scenario": "windows_to_kylin",
  "level": "L3",
  "build": {
    "command": "cmake -S . -B {build} -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DENABLE_TESTS=ON -DENABLE_FOUNDATION=ON -DENABLE_NET=OFF -DENABLE_CRYPTO=OFF -DENABLE_NETSSL=OFF -DENABLE_JWT=OFF -DENABLE_DATA=OFF -DENABLE_MONGODB=OFF -DENABLE_REDIS=OFF -DENABLE_PROMETHEUS=OFF -DENABLE_ZIP=OFF -DENABLE_UTIL=OFF -DENABLE_XML=OFF -DENABLE_JSON=OFF -DENABLE_ENCODINGS=OFF -DENABLE_PAGECOMPILER=OFF -DENABLE_PAGECOMPILER_FILE2PAGE=OFF -DENABLE_ACTIVERECORD=OFF -DENABLE_ACTIVERECORD_COMPILER=OFF -DENABLE_CPPPARSER=OFF -DENABLE_POCODOC=OFF -DENABLE_APACHECONNECTOR=OFF -DENABLE_PDF=OFF -DENABLE_SEVENZIP=OFF -DENABLE_DATA_SQLITE=OFF -DENABLE_DATA_MYSQL=OFF -DENABLE_DATA_ODBC=OFF -DENABLE_DATA_POSTGRESQL=OFF && cmake --build {build} -j2",
    "artifact": "{build}/lib/libPocoFoundation.a"
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "cd {build}/bin && LD_LIBRARY_PATH=\"$PWD:$LD_LIBRARY_PATH\" PATH=\"$PWD:$PATH\" ./Foundation-testrunner -ignore {work}/cppignore.lnx ThreadTest FileTest PathTest RWLockTest SemaphoreTest SharedLibraryTest ProcessTest"
  },
  "gates": {
    "build": "configure and build the task target on Kylin V10",
    "api_removal": {
      "symbol_regex": "^(__imp_|CreateFileA|CreateFileW|ReadFile|WriteFile|WaitForSingleObject|WSAStartup|RegOpenKeyEx|RegCreateKeyEx|CoCreateInstance|LoadLibraryA|LoadLibraryW)",
      "source_regex": "windows\\.h|__declspec|_MSC_VER|#pragma comment|TCHAR\\b|\\bCreateFile\\b|WaitForSingleObject|RegOpenKey|CoCreateInstance",
      "exclude_globs": [
        "**/*_WIN32*",
        "**/*_win32*",
        "**/*w32*",
        "**/*W32*",
        "**/*_windows.c",
        "**/*_windows.h",
        "**/win32/**",
        "**/Win32/**",
        "**/win/**",
        "**/Windows/**",
        "**/windows/**",
        "**/projects/Windows/**",
        "**/winbuild/**"
      ],
      "source_dirs": [
        "Foundation/src/DirectoryIterator_UNIX.cpp",
        "Foundation/src/Environment_UNIX.cpp",
        "Foundation/src/Event_POSIX.cpp",
        "Foundation/src/FileStream_POSIX.cpp",
        "Foundation/src/File_UNIX.cpp",
        "Foundation/src/Mutex_POSIX.cpp",
        "Foundation/src/NamedEvent_UNIX.cpp",
        "Foundation/src/NamedMutex_UNIX.cpp",
        "Foundation/src/Path_UNIX.cpp",
        "Foundation/src/PipeImpl_POSIX.cpp",
        "Foundation/src/Process_UNIX.cpp",
        "Foundation/src/RWLock_POSIX.cpp",
        "Foundation/src/Semaphore_POSIX.cpp",
        "Foundation/src/SharedLibrary_UNIX.cpp",
        "Foundation/src/SharedMemory_POSIX.cpp",
        "Foundation/src/Thread_POSIX.cpp",
        "Foundation/src/Timezone_UNIX.cpp"
      ]
    },
    "behavior": "Foundation builds and the core platform suites pass"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.16.5"
  },
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ]
}
