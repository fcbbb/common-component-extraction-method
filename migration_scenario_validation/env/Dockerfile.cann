# Ascend/CANN test image for Scenario B (CUDA -> Ascend).
#
# The CANN base image is NOT vendored here (it needs a vendor account and a
# matching driver/firmware).  Provide a CANN 9.1.0+ image:
#
#   # CANN Bench profile (torch 2.10.0 / torch_npu 2.10.0.post4)
#   docker build -f env/Dockerfile.cann \
#     --build-arg BASE_IMAGE=<cann-9.1.0-image> \
#     --build-arg TORCH_VERSION=2.10.0 \
#     --build-arg TORCH_NPU_VERSION=2.10.0.post4 \
#     -t migration/cann:cannbench .
#
#   # MultiKernelBench profile (torch 2.7.0 / torch_npu 2.7.1)
#   docker build -f env/Dockerfile.cann \
#     --build-arg BASE_IMAGE=<cann-image-compatible-with-torch_npu-2.7.1> \
#     --build-arg TORCH_VERSION=2.7.0 \
#     --build-arg TORCH_NPU_VERSION=2.7.1 \
#     -t migration/cann:mkbench .
#
# The two profiles must not share a venv.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV ASCEND_HOME_PATH=/usr/local/Ascend/ascend-toolkit/latest

ARG TORCH_VERSION=2.10.0
ARG TORCH_NPU_VERSION=2.10.0.post4
ARG PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git curl ca-certificates \
      python3 python3-pip python3-venv \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# torch/npu wheels are large; keep them in the image, not in a fresh venv.
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir \
         "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu \
    && python3 -m pip install --no-cache-dir \
         "torch_npu==${TORCH_NPU_VERSION}" -i "${PIP_INDEX_URL}"

# `uv` is what CANN Bench's pyproject/uv.lock expects; the pip install above
# already pins the two packages whose ABI must match the CANN runtime.
RUN python3 -m pip install --no-cache-dir uv

RUN if [ -f /usr/local/Ascend/ascend-toolkit/set_env.sh ]; then \
      echo "source /usr/local/Ascend/ascend-toolkit/set_env.sh" >> /etc/profile.d/cann.sh; \
    fi

RUN useradd --create-home --shell /bin/bash bench \
    && mkdir -p /work /cache \
    && chown -R bench:bench /work /cache
USER bench
WORKDIR /work
ENV MIGRATION_BENCH_CACHE=/cache/migration-bench

# Check only what can be checked without a driver.  Importing torch_npu on a
# build host without the NPU driver can fail even though the image is fine, so
# device visibility is verified on the target host with `npu-smi info`.
RUN python3 -c "import torch; print('torch', torch.__version__)" \
    && python3 -m pip show torch_npu | sed -n '1,2p'

CMD ["/bin/bash"]