# Copy to bench.env (gitignored) and fill in.  run-default.sh / run-method.sh
# source this file, then export the values into the environment.
#
# Precedence inside baseline_trial.py: CLI flag > .env at the repository root
# (../.env) > this environment.  If ../.env already has the working route,
# leave these empty and do not create bench.env.

OPENAI_API_BASE=
OPENAI_API_KEY=
MODEL_NAME=

# IPP -> VSIPL target tree (contains include/vsip.h and lib/libvsip.a).
# VSIPL_ROOT=/path/to/jvsip

# Optional method-arm overrides (defaults are in bench.yaml).
# METHOD_EXTRACTION_WORKERS=2
# BENCH_METHOD_DSH_PROFILE=component-method-migration

# Optional DSH runtime overrides (defaults: Node 24.9.0, the repository's dsh/).
# COMPONENT_DSH_NODE_BIN=/home/you/.nvm/versions/node/v24.9.0/bin/node