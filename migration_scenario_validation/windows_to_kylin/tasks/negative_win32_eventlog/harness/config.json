{
  "task_id": "negative_win32_eventlog",
  "scenario": "windows_to_kylin",
  "level": "L3",
  "build": {
    "mode": "none",
    "command": ""
  },
  "public_tests": null,
  "hidden_tests": {
    "command": "test -s {work}/PORTING_NOTES.md && grep -qiE 'event ?log|not portable|no (direct )?(linux|posix|kylin) equivalent' {work}/PORTING_NOTES.md"
  },
  "gates": {
    "build": "not applicable: the module cannot be built on Kylin",
    "api_removal": {
      "symbol_regex": "^(ReportEvent|RegisterEventSource|DeregisterEventSource|OpenEventLog)",
      "source_regex": "windows\\.h|ReportEvent|RegisterEventSource|HKEY_|RegCreateKey|pocomsg",
      "exclude_globs": [],
      "expect_fail": true,
      "source_dirs": [
        "Foundation/src/EventLogChannel.cpp"
      ]
    },
    "behavior": "PORTING_NOTES.md documents the non-portability and no fake backend is added"
  },
  "target": {
    "os": "kylin-v10-sp3",
    "arch": "x86_64",
    "toolchain": "gcc-13.3",
    "cmake": "3.28"
  },
  "placeholders": [
    "{root}",
    "{work}",
    "{build}",
    "{golden}"
  ]
}